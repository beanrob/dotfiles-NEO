#!/bin/sh
bssid=$(nmcli device wifi list | sed -n '1!p' | cut -b 9- | rofi -dmenu -p "network" | cut -d' ' -f1)
if [ "$bssid" != "" ]; then
	pass=$(echo "" | rofi -dmenu -p "password ")
	if [ "$pass" = "" ]; then
		nmcli device wifi connect $bssid
	else
		nmcli device wifi connect $bssid password $pass
	fi
fi
